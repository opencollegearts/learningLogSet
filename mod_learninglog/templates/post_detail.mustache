<article class="learninglog-post">
    {{#bannerurl}}
    <div class="mb-3">
        <div class="ratio ratio-21x9">
            <img src="{{bannerurl}}" class="w-100 object-fit-cover" alt="">
        </div>
    </div>
    {{/bannerurl}}

    <header class="mb-3">
        <h2>{{title}}</h2>
        <p class="text-muted small mb-1">{{date}}</p>
        <p class="small mb-0">{{#str}}postedby, mod_learninglog{{/str}} {{fullname}}</p>
        {{#editurl}}
        <p class="mb-0 mt-2">
            <a href="{{editurl}}" class="btn btn-outline-secondary btn-sm">{{#str}}editpost, mod_learninglog{{/str}}</a>
            {{#deleteurl}}
            <a href="{{deleteurl}}" class="btn btn-outline-danger btn-sm">{{#str}}deletepost, mod_learninglog{{/str}}</a>
            {{/deleteurl}}
        </p>
        {{/editurl}}
    </header>

    <div class="mb-4">
        {{{content}}}
    </div>

    {{#hascommentsection}}
    <section class="learninglog-comments mt-4 border-top pt-3">
        <h3 class="h5">{{#str}}comments, mod_learninglog{{/str}}</h3>
        <ul class="list-unstyled">
            {{#comments}}
            <li class="mb-3 pb-2 border-bottom">
                <p class="small text-muted mb-1">{{fullname}} — {{date}}{{#deleteurl}} <a href="{{deleteurl}}" class="text-danger">{{#str}}deletecomment, mod_learninglog{{/str}}</a>{{/deleteurl}}</p>
                <p class="mb-0">{{content}}</p>
            </li>
            {{/comments}}
        </ul>
        {{#showcommentform}}
        <form method="post" action="{{commentformaction}}" class="mt-3">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="mb-2">
                <label for="learninglog-comment-content" class="form-label">{{#str}}addcomment, mod_learninglog{{/str}}</label>
                <textarea name="content" id="learninglog-comment-content" class="form-control" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">{{#str}}submitcomment, mod_learninglog{{/str}}</button>
        </form>
        {{/showcommentform}}
    </section>
    {{/hascommentsection}}
</article>

