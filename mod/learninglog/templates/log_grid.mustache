{{! Grid of learning log tiles - banner as background with tint, description on hover }}
<div class="container-fluid">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 learninglog-log-grid">
        {{#cards}}
        <div class="col">
            <article class="learninglog-log-tile card h-100 shadow-sm {{#bannerurl}}has-banner{{/bannerurl}}">
                {{#bannerurl}}
                <div class="tile-background learninglog-fade-in" style="background-image: url({{bannerurl}});" aria-hidden="true"></div>
                <div class="tile-tint"></div>
                {{/bannerurl}}

                <div class="tile-content card-body d-flex flex-column">
                    <h3 class="card-title h5 mb-1">
                        <a href="{{url}}" class="tile-title-link">{{title}}</a>
                    </h3>
                    <p class="card-text small text-muted mb-2 tile-meta">{{coursename}} · {{fullname}}</p>
                    {{#summary}}
                    <p class="card-text tile-excerpt mb-3">{{summary}}</p>
                    {{/summary}}

                    <div class="mt-auto">
                        <a href="{{url}}" class="btn btn-sm btn-outline-light">{{#str}}view, local_learninglog{{/str}}</a>
                    </div>
                </div>
            </article>
        </div>
        {{/cards}}
        {{^cards}}
        <div class="col">
            <div class="alert alert-info">{{#str}}nositewidelogs, local_learninglog{{/str}}</div>
        </div>
        {{/cards}}
    </div>
</div>
